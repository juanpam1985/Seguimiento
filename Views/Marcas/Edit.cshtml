@model Seguimiento.Models.Marca

@{
    ViewData["Title"] = "Editar Marca";

    var empresas = ViewBag.Empresas as List<Seguimiento.Models.Empresa>;
    var seleccionadas = ViewBag.EmpresasSeleccionadas as List<int>;
}

<div class="container mt-4">

    <div class="card shadow-lg border-0">

        <!-- HEADER -->
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">✏️ Editar Marca</h4>
        </div>

        <!-- BODY -->
        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="Id" />

                <!-- NOMBRE -->
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <!-- EMPRESAS -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Empresas</label>

                    <div style="border:1px solid #eee; border-radius:8px; padding:10px; max-height:200px; overflow-y:auto;">

                        @foreach (var emp in empresas)
                        {
                            var isChecked = seleccionadas != null && seleccionadas.Contains(emp.Id);

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="empresasSeleccionadas"
                                       value="@emp.Id"
                                @(isChecked ? "checked" : "") />

                                <label class="form-check-label">
                                    @emp.Nombre
                                </label>
                            </div>
                        }

                    </div>

                </div>

                <!-- ACTIVO -->
                <div class="form-check mt-3">
                    <input asp-for="Activo" class="form-check-input" />
                    <label asp-for="Activo" class="form-check-label fw-bold"></label>
                </div>

                <!-- BOTONES -->
                <div class="mt-4 d-flex justify-content-between">

                    <a asp-action="Index" class="btn btn-secondary">
                        ← Volver
                    </a>

                    <button type="submit" class="btn btn-success">
                        💾 Guardar Cambios
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}