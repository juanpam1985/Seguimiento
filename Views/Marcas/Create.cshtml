@model Seguimiento.Models.Marca

@{
    ViewData["Title"] = "Crear Marca";
    var empresas = ViewBag.Empresas as List<Seguimiento.Models.Empresa>;
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .btn-lozano {
        background: #f05a28;
        border: none;
        color: white;
        font-weight: 500;
    }

        .btn-lozano:hover {
            background: #d84c1b;
        }

    .card-form {
        background: white;
        border-radius: 12px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        max-width: 650px;
        margin: auto;
    }

    .section-title {
        font-weight: 600;
        margin-bottom: 20px;
        color: #2c3e50;
        border-left: 4px solid #f05a28;
        padding-left: 10px;
    }

    .empresa-box {
        border: 1px solid #eee;
        border-radius: 8px;
        padding: 10px;
        max-height: 200px;
        overflow-y: auto;
    }

    .btn-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }
</style>

<div class="container mt-4">

    <div class="page-header">
        <h3>🚗 Crear Marca</h3>

        <a asp-action="Index" class="btn btn-secondary">
            ← Volver
        </a>
    </div>

    <div class="card-form">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="section-title">
                Información de la Marca
            </div>

            <!-- NOMBRE -->
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-bold"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Toyota, Kia..." />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <!-- EMPRESAS MULTIPLE -->
            <div class="mb-3">
                <label class="form-label fw-bold">Empresas</label>

                <div class="empresa-box">

                    @foreach (var emp in empresas)
                    {
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="empresasSeleccionadas"
                                   value="@emp.Id" />

                            <label class="form-check-label">
                                @emp.Nombre
                            </label>
                        </div>
                    }

                </div>

                <small class="text-muted">
                    Seleccione una o varias empresas
                </small>
            </div>

            <!-- ACTIVO -->
            <div class="form-check mt-3">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label fw-bold"></label>
            </div>

            <!-- BOTONES -->
            <div class="btn-actions">
                <button type="submit" class="btn btn-lozano">
                    💾 Guardar Marca
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancelar
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}