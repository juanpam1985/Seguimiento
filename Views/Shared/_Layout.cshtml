<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sistema Seguimiento Embarques</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/Seguimiento.styles.css" asp-append-version="true" />

    <style>

        html, body {
            height: 100%;
            width: 100%;
        }

        main {
            width: 100%;
        }

        .full-width-page {
            width: 100%;
            max-width: 100%;
            padding-left: 25px;
            padding-right: 25px;
        }

    </style>

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Sistema Embarques
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMain">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="navbarMain">

                    <ul class="navbar-nav me-auto">

                     
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Empresas" asp-action="Index">Empresas</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Marcas" asp-action="Index">Marcas</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Modelos" asp-action="Index">Modelos</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Preguntas" asp-action="Index">Preguntas</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="OpcionesLista" asp-action="Index">Opciones Lista</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Embarques" asp-action="Dashboard">Embarques</a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>



    <main class="full-width-page">

        @RenderBody()

    </main>



    


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
