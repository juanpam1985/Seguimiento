@using Microsoft.AspNetCore.Http
@using Seguimiento.Data
@using Seguimiento.Helpers
@inject IHttpContextAccessor HttpContextAccessor
@inject ApplicationDbContext Db

@{
    var usuario = HttpContextAccessor.HttpContext.Session.GetString("UsuarioNombre");
    var empresa = HttpContextAccessor.HttpContext.Session.GetString("EmpresaNombre");
    var rolNombre = HttpContextAccessor.HttpContext.Session.GetString("RolNombre");
    var rolId = HttpContextAccessor.HttpContext.Session.GetInt32("RolId");

    bool verEmpresas = PermisoHelper.TienePermiso(Db, rolId, "EMPRESAS", "VER");
    bool verUsuarios = PermisoHelper.TienePermiso(Db, rolId, "USUARIOS", "VER");
    bool verMarcas = PermisoHelper.TienePermiso(Db, rolId, "MARCAS", "VER");
    bool verModelos = PermisoHelper.TienePermiso(Db, rolId, "MODELOS", "VER");
    bool verColores = PermisoHelper.TienePermiso(Db, rolId, "COLORES", "VER");
    bool verPreguntas = PermisoHelper.TienePermiso(Db, rolId, "PREGUNTAS", "VER");
    bool verOpciones = PermisoHelper.TienePermiso(Db, rolId, "OPCIONES", "VER");
    bool verEmbarques = PermisoHelper.TienePermiso(Db, rolId, "EMBARQUES", "VER");
    bool crearEmbarques = PermisoHelper.TienePermiso(Db, rolId, "EMBARQUES", "CREAR");
    bool verKpi = PermisoHelper.TienePermiso(Db, rolId, "KPI", "VER");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Embarques</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell-wide">
        <header class="top-command">
            <div class="top-command-main">
                <a class="brand-mark" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo-box">
                        <img src="~/images/logo-lozano.png" alt="Lozano Asesores" />
                    </span>
                    <span class="brand-copy">
                        <strong>Sistema Embarques</strong>
                        <small>Control operativo y gerencial</small>
                    </span>
                </a>

                <button class="navbar-toggler command-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

            </div>

            <nav class="navbar navbar-expand-lg command-nav">
                <div class="container-fluid px-0">
                    <div class="collapse navbar-collapse" id="navbarMain">
                        <ul class="navbar-nav me-auto nav-pills-command">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door"></i> Inicio
                                </a>
                            </li>

                            @if (verEmbarques)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-highlight" asp-controller="Embarques" asp-action="Dashboard">
                                        <i class="bi bi-truck-front-fill"></i> Embarques
                                    </a>
                                </li>
                            }

                            @if (verKpi)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="KPI" asp-action="Index">
                                        <i class="bi bi-graph-up-arrow"></i> KPI
                                    </a>
                                </li>
                            }

                            @if (verEmpresas || verUsuarios)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-sliders"></i> Administración
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-premium">
                                        <li class="dropdown-header">Gestión base</li>
                                        @if (verEmpresas)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Empresas" asp-action="Index">
                                                    <i class="bi bi-buildings"></i> Empresas
                                                </a>
                                            </li>
                                        }
                                        @if (verUsuarios)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">
                                                    <i class="bi bi-person-badge"></i> Usuarios
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }

                            @if (verMarcas || verModelos || verColores || verPreguntas || verOpciones)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-tools"></i> Mantenimiento
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-premium">
                                        <li class="dropdown-header">Configuración</li>
                                        @if (verMarcas)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Marcas" asp-action="Index">
                                                    <i class="bi bi-tags"></i> Marcas
                                                </a>
                                            </li>
                                        }
                                        @if (verModelos)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Modelos" asp-action="Index">
                                                    <i class="bi bi-box-seam"></i> Modelos
                                                </a>
                                            </li>
                                        }
                                        @if (verColores)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Colores" asp-action="Index">
                                                    <i class="bi bi-palette"></i> Colores
                                                </a>
                                            </li>
                                        }
                                        @if (verPreguntas)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Preguntas" asp-action="Index">
                                                    <i class="bi bi-ui-checks-grid"></i> Preguntas
                                                </a>
                                            </li>
                                        }
                                        @if (verOpciones)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="OpcionesLista" asp-action="Index">
                                                    <i class="bi bi-list-check"></i> Opciones Lista
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>

                        <ul class="navbar-nav ms-auto nav-session-mobile d-xl-none">
                            <li class="nav-item"><span class="nav-link"><i class="bi bi-building"></i> @(empresa ?? "Sin empresa")</span></li>
                            <li class="nav-item"><span class="nav-link"><i class="bi bi-person-circle"></i> @(usuario ?? "Usuario")</span></li>
                            <li class="nav-item"><span class="nav-link"><i class="bi bi-shield-check"></i> @(rolNombre ?? "Rol")</span></li>
                        </ul>

                        <a class="btn btn-logout ms-lg-2" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right"></i> Salir
                        </a>
                    </div>
                </div>
            </nav>

            <div class="session-strip d-none d-xl-flex">
                <span class="session-chip empresa-chip"><i class="bi bi-building"></i> @(empresa ?? "Sin empresa")</span>
                <span class="session-chip"><i class="bi bi-person-circle"></i> @(usuario ?? "Usuario")</span>
                <span class="session-chip role-chip"><i class="bi bi-shield-check"></i> @(rolNombre ?? "Rol")</span>
            </div>
        </header>

        <main class="content-wide">
            <div class="location-bar">
                <div>
                    <span class="location-dot"></span>
                    <span>Inicio</span>
                    <i class="bi bi-chevron-right"></i>
                    <strong>@ViewData["Title"]</strong>
                </div>
                <small>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
            </div>

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
