@model Seguimiento.Models.Usuario

@{
    ViewData["Title"] = "Crear Usuario";
    var empresas = ViewBag.Empresas as List<Seguimiento.Models.Empresa> ?? new List<Seguimiento.Models.Empresa>();
    var roles = ViewBag.Roles as List<Seguimiento.Models.Rol> ?? new List<Seguimiento.Models.Rol>();
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .btn-lozano {
        background: #f05a28;
        border: none;
        color: white;
        font-weight: 500;
    }

        .btn-lozano:hover {
            background: #d84c1b;
            color: white;
        }

    .card-form {
        background: white;
        border-radius: 12px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        max-width: 850px;
        margin: auto;
    }

    .section-title {
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 15px;
        color: #2c3e50;
        border-left: 4px solid #f05a28;
        padding-left: 10px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .empresa-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 10px;
    }

    .empresa-item {
        border: 1px solid #e8e8e8;
        border-radius: 8px;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fafafa;
        transition: 0.2s;
        cursor: pointer;
    }

        .empresa-item:hover {
            background: #f2f6ff;
            border-color: #d0dfff;
        }

    .form-control {
        border-radius: 6px;
    }

    .btn-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }
</style>

<div class="container mt-4">

    <div class="page-header">
        <h3>👤 Crear Usuario</h3>

        <a asp-action="Index" class="btn btn-secondary">
            ← Volver
        </a>
    </div>

    <div class="card-form">

        <form asp-action="Create" method="post">

            <!-- 🔥 ERRORES -->
            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <div class="section-title">
                Información del usuario
            </div>

            <div class="form-grid">

                <div>
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="UsuarioLogin" class="form-label"></label>
                    <input asp-for="UsuarioLogin" class="form-control" />
                </div>

                <div>
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="PasswordHash" class="form-label">Contraseña</label>
                    <input asp-for="PasswordHash" type="password" class="form-control" />
                    <span asp-validation-for="PasswordHash" class="text-danger"></span>
                </div>

                <!-- 🔥 ROL CORREGIDO -->
                <div>
                    <label asp-for="RolId" class="form-label">Rol</label>

                    <select asp-for="RolId" class="form-control"
                            asp-items="@(new SelectList(roles, "Id", "Nombre"))">
                        <option value="">-- Seleccione Rol --</option>
                    </select>

                    <span asp-validation-for="RolId" class="text-danger"></span>
                </div>

            </div>

            <div class="form-check mt-3">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label"></label>
            </div>

            <div class="section-title">
                Empresas asignadas
            </div>

            <!-- 🔥 IMPORTANTE -->
            <input type="hidden" name="empresasSeleccionadas" value="0" />

            <div class="empresa-grid">

                @foreach (var emp in empresas)
                {
                    <label class="empresa-item">

                        <input type="checkbox"
                               name="empresasSeleccionadas"
                               value="@emp.Id"
                               class="form-check-input" />

                        <span>@emp.Nombre</span>

                    </label>
                }

            </div>

            <div class="btn-actions">

                <button type="submit" class="btn btn-lozano">
                    💾 Crear Usuario
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}