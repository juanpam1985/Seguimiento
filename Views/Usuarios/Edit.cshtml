@model Seguimiento.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";

    var empresas = ViewBag.Empresas as List<Seguimiento.Models.Empresa> ?? new List<Seguimiento.Models.Empresa>();
    var seleccionadas = ViewBag.EmpresasSeleccionadas as List<int> ?? new List<int>();
    var roles = ViewBag.Roles as List<Seguimiento.Models.Rol> ?? new List<Seguimiento.Models.Rol>();
}

<div class="container mt-4">

    <h3>✏️ Editar Usuario</h3>

    <form asp-action="Edit" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="row">

            <div class="col-md-6">
                <label asp-for="Nombre"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="UsuarioLogin"></label>
                <input asp-for="UsuarioLogin" class="form-control" />
            </div>

            <div class="col-md-6 mt-2">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="col-md-6 mt-2">
                <label>Nueva Contraseña</label>
                <input type="password" name="NuevaPassword" class="form-control" />
                <small class="text-muted">Dejar en blanco si no desea cambiarla</small>
            </div>

            <!-- 🔥 ROL -->
            <div class="col-md-6 mt-2">
                <label>Rol</label>
                <select asp-for="RolId" class="form-control">

                    <option value="">-- Seleccione Rol --</option>

                    @foreach (var rol in roles)
                    {
                        <option value="@rol.Id" selected="@(rol.Id == Model.RolId)">
                            @rol.Nombre
                        </option>
                    }

                </select>
            </div>

        </div>

        <div class="form-check mt-3">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo"></label>
        </div>

        <hr />

        <h5>Empresas asignadas</h5>

        <!-- 🔥 ESTE HIDDEN EVITA ERRORES CUANDO NO MARCAN NADA -->
        <input type="hidden" name="empresasSeleccionadas" value="0" />

        <div class="row">

            @foreach (var emp in empresas)
            {
                var isChecked = seleccionadas.Contains(emp.Id);

                <div class="col-md-6">

                    <div class="form-check">

                        <input type="checkbox"
                               name="empresasSeleccionadas"
                               value="@emp.Id"
                               class="form-check-input"
                        @(isChecked ? "checked" : null) />

                        <label class="form-check-label">@emp.Nombre</label>

                    </div>

                </div>
            }

        </div>

        <br />

        <button type="submit" class="btn btn-primary">
            💾 Guardar Cambios
        </button>

        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

    </form>

</div>