@model Seguimiento.Models.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0">

        <!-- HEADER -->
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">🗑️ Eliminar Usuario</h4>
        </div>

        <!-- BODY -->
        <div class="card-body">

            <div class="alert alert-warning">
                ⚠️ ¿Está seguro que desea eliminar este usuario? Esta acción no se puede deshacer.
            </div>

            <dl class="row">

                <dt class="col-sm-3 fw-bold">Nombre</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3 fw-bold">Usuario</dt>
                <dd class="col-sm-9">@Model.UsuarioLogin</dd>

                <dt class="col-sm-3 fw-bold">Correo</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3 fw-bold">Rol</dt>
                <dd class="col-sm-9">
                    @(Model.Rol != null ? Model.Rol.Nombre : "Sin rol")
                </dd>

                <dt class="col-sm-3 fw-bold">Estado</dt>
                <dd class="col-sm-9">
                    @if (Model.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </dd>

                <dt class="col-sm-3 fw-bold">Empresas</dt>
                <dd class="col-sm-9">

                    @if (Model.UsuarioEmpresas != null && Model.UsuarioEmpresas.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var item in Model.UsuarioEmpresas)
                            {
                                <li>@item.Empresa?.Nombre</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">Sin empresas asignadas</span>
                    }

                </dd>

            </dl>

        </div>

        <!-- FOOTER -->
        <div class="card-footer d-flex justify-content-between">

            <a asp-action="Index" class="btn btn-secondary">
                ← Cancelar
            </a>

            <form asp-action="Delete" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    🗑️ Eliminar
                </button>
            </form>

        </div>

    </div>

</div>