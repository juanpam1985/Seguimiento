@model Seguimiento.Models.Empresa

@{
    ViewData["Title"] = "Nueva Empresa";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">🏢 Crear Nueva Empresa</h4>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Nombre -->
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold"></label>
                    <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ingrese el nombre de la empresa" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <!-- Activo -->
                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" asp-for="Activo" />
                    <label class="form-check-label fw-bold" asp-for="Activo"></label>
                </div>

                <!-- Botones -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        ← Volver
                    </a>

                    <button type="submit" class="btn btn-success px-4">
                        💾 Guardar
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}