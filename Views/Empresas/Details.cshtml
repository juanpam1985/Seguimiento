@model Seguimiento.Models.Empresa

@{
    ViewData["Title"] = "Detalles Empresa";
}

<h2>🏢 Detalle de Empresa</h2>

@if (Model == null)
{
    <div class="alert alert-danger">
        No se encontró la empresa.
    </div>
}
else
{
    <div class="card shadow p-3">
        <dl class="row">
            <dt class="col-sm-3 fw-bold">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3 fw-bold">Estado</dt>
            <dd class="col-sm-9">
                @(Model.Activo ? "Activo" : "Inactivo")
            </dd>
        </dl>
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            ✏️ Editar
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            ← Volver
        </a>
    </div>
}