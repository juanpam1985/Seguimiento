@model Seguimiento.Models.Empresa

@{
    ViewData["Title"] = "Eliminar Empresa";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0">

        <!-- HEADER -->
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">🏢 Eliminar Empresa</h4>
        </div>

        <!-- BODY -->
        <div class="card-body">

            <div class="alert alert-warning">
                ⚠️ ¿Está seguro que desea eliminar esta empresa?
                Esta acción puede afectar usuarios y marcas relacionadas.
            </div>

            <dl class="row">

                <dt class="col-sm-3 fw-bold">Nombre</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3 fw-bold">Estado</dt>
                <dd class="col-sm-9">
                    @if (Model.Activo)
                    {
                        <span class="badge bg-success">Activa</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactiva</span>
                    }
                </dd>

            </dl>

        </div>

        <!-- FOOTER -->
        <div class="card-footer d-flex justify-content-between">

            <a asp-action="Index" class="btn btn-secondary">
                ← Cancelar
            </a>

            <form asp-action="Delete" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    🗑️ Eliminar
                </button>
            </form>

        </div>

    </div>

</div>