@model List<Seguimiento.Models.Embarque>

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    body {
        background-color: #f4f6fb;
    }

    .kpi-card {
        border-radius: 14px;
        padding: 20px;
        color: white;
        font-weight: 600;
        box-shadow: 0px 6px 15px rgba(0,0,0,0.08);
        transition: 0.3s;
    }

        .kpi-card:hover {
            transform: translateY(-5px);
        }

    .kpi-title {
        font-size: 14px;
    }

    .kpi-value {
        font-size: 32px;
        font-weight: bold;
    }

    .kpi-icon {
        float: right;
        font-size: 28px;
        opacity: 0.3;
    }

    .kpi-total {
        background: #2563eb;
    }

    .kpi-transito {
        background: #06b6d4;
    }

    .kpi-entregado {
        background: #16a34a;
    }

    .kpi-retraso {
        background: #dc2626;
    }

    .card-container {
        background: white;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0px 3px 8px rgba(0,0,0,0.05);
    }

    .table thead {
        background: #111827;
        color: white;
        font-size: 13px;
    }

    .table tbody tr:hover {
        background-color: #eef2ff;
    }

    .badge-custom {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        color: white;
    }

    .bg-ok {
        background: #16a34a;
    }

    .bg-transit {
        background: #f59e0b;
    }

    .bg-delay {
        background: #dc2626;
    }

    .btn-xs {
        padding: 4px 8px;
        font-size: 12px;
        border-radius: 6px;
    }

    .fab {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 65px;
        height: 65px;
        background-color: #22c55e;
        color: white;
        border-radius: 50%;
        font-size: 32px;
        text-align: center;
        line-height: 65px;
        box-shadow: 0px 6px 15px rgba(0,0,0,0.2);
        text-decoration: none;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>📊 Dashboard - <span style="color:#2563eb">@ViewBag.NombreEmpresa</span></h2>
    <a asp-action="Create" class="btn btn-success">➕ Nuevo Embarque</a>
</div>

@functions {

    string GetValor(List<Seguimiento.Models.Respuesta> respuestas, string nombre)
    {
        return respuestas.FirstOrDefault(r =>
            r.Pregunta != null &&
            r.Pregunta.Nombre.ToUpper().Contains(nombre.ToUpper())
        )?.Valor ?? "";
    }

    int GetNumero(List<Seguimiento.Models.Respuesta> respuestas, string nombre)
    {
        var val = GetValor(respuestas, nombre);
        return int.TryParse(val, out int n) ? n : 0;
    }

    DateTime? GetFecha(List<Seguimiento.Models.Respuesta> respuestas, string nombre)
    {
        var val = GetValor(respuestas, nombre);
        return DateTime.TryParse(val, out DateTime d) ? d : (DateTime?)null;
    }
}

@{
    int total = ViewBag.Total;
    int enTransito = ViewBag.EnTransito;
    int entregados = ViewBag.Entregados;
    int retrasados = ViewBag.Retrasados;

    var camposObligatorios = new List<string>
    {
        "ETA",
        "TRÁNSITO",
        "HOMOLOGATION",
        "CERTIFICADO 017 INEN",
        "AFIP",
        "INVOICES",
        "BLs",
        "BL",
        "COs",
        "APLICACIONES DE SEGURO",
        "LICENCIA INEN",
        "PACKING",
        "SUBCATEGOR",
        "NOTIFICACIÓN SRI",
        "DESTINO ADUANERO",
        "TIPO DE PAGO",
        "DIAS LIBRES",
        "MRN",
        "PRE-LIQUIDACIÓN",
        "EMISION BL",
        "CAS",
        "PAGO FLETE",
        "ORIGINAL",
        "ESTADO DEL BUQUE"
    };

    
}

<!-- KPI -->
<!-- KPI -->
<div class="row mb-4">

    <div class="col-md-3">
        <a asp-controller="Embarques" asp-action="Dashboard" style="text-decoration:none;">
            <div class="kpi-card kpi-total">
                <div class="kpi-icon">📦</div>
                <div class="kpi-title">Total Embarques</div>
                <div class="kpi-value">@total</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Embarques" asp-action="Dashboard" asp-route-filtro="transito" style="text-decoration:none;">
            <div class="kpi-card kpi-transito">
                <div class="kpi-icon">🚢</div>
                <div class="kpi-title">En tránsito</div>
                <div class="kpi-value">@enTransito</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Embarques" asp-action="Dashboard" asp-route-filtro="entregado" style="text-decoration:none;">
            <div class="kpi-card kpi-entregado">
                <div class="kpi-icon">✅</div>
                <div class="kpi-title">Entregados</div>
                <div class="kpi-value">@entregados</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Embarques" asp-action="Dashboard" asp-route-filtro="retrasado" style="text-decoration:none;">
            <div class="kpi-card kpi-retraso">
                <div class="kpi-icon">⚠️</div>
                <div class="kpi-title">Retrasados</div>
                <div class="kpi-value">@retrasados</div>
            </div>
        </a>
    </div>

</div>

<!-- TABLA -->
<div class="card-container">
    <div class="table-responsive">
        <table class="table table-bordered table-sm align-middle">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Shipment</th>
                    <th>Empresa</th>
                    <th>Marca</th>
                    <th>Destino</th>
                    <th>Naviera</th>
                    <th>Cantidad</th>
                    <th>Salida</th>
                    <th>ETA</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    var r = item.Respuestas?.ToList() ?? new List<Seguimiento.Models.Respuesta>();

                    var status = GetValor(r, "STATUS");
                    var shipment = GetValor(r, "SHIPMENT");
                    var marcaId = GetValor(r, "BRAND");

                    var nombreMarca = (ViewBag.Marcas as List<Seguimiento.Models.Marca>)
                    ?.FirstOrDefault(m => m.Id.ToString() == marcaId)?.Nombre ?? "";

                    var destino = GetValor(r, "DESTINATION");
                    var naviera = GetValor(r, "SHIPPING");

                    var qty = item.EmbarqueModelos?.Sum(x => x.Cantidad) ?? 0;

                    var salida = GetFecha(r, "DEPARTURE");
                    var eta = GetFecha(r, "ETA");

                    var departure = GetFecha(r, "DEPARTURE");

                    bool esRetrasado = false;

                    if (departure.HasValue && departure.Value.Date.AddDays(1) < DateTime.Now.Date)
                    {
                        foreach (var campo in camposObligatorios)
                        {
                            var valor = GetValor(r, campo);

                            if (string.IsNullOrWhiteSpace(valor))
                            {
                                esRetrasado = true;
                                break;
                            }
                        }
                    }

                    string estadoHtml = "";

                    if (esRetrasado)
                    {
                        estadoHtml = "<span class='badge-custom bg-delay'>Retrasado</span>";
                    }
                    else
                    {
                        estadoHtml = "<span class='badge-custom bg-transit'>En tránsito</span>";
                    }
                    <tr>

                        <!-- STATUS REAL -->
                        <td>
                            @if (status.ToUpper() == "OPEN")
                            {
                                <span class="badge-custom bg-transit">@status</span>
                            }
                            else if (status.ToUpper() == "CLOSED")
                            {
                                <span class="badge-custom bg-ok">@status</span>
                            }
                            else
                            {
                                <span class="badge-custom bg-delay">@status</span>
                            }
                        </td>

                        <td>@shipment</td>
                        <td>@item.Empresa?.Nombre</td>
                        <td>@nombreMarca</td>
                        <td>@destino</td>
                        <td>@naviera</td>
                        <td><strong>@qty</strong></td>
                        <td>@(salida?.ToString("dd/MM/yyyy"))</td>
                        <td>@(eta?.ToString("dd/MM/yyyy"))</td>
                        <td>@Html.Raw(estadoHtml)</td>

                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-warning">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-info text-white">Detalle</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-xs btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>

<a asp-action="Create" class="fab">+</a>