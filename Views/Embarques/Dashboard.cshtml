@model IEnumerable<Seguimiento.Models.Embarque>

@{
    ViewData["Title"] = "Dashboard Embarques";

    var hoy = DateTime.Today;

    var enTransito = Model.Where(x => x.Estado == "IN TRANSIT").Count();
    var abiertos = Model.Where(x => x.Estado == "OPEN").Count();
    var arribados = Model.Where(x => x.Estado == "ARRIVED").Count();

    var etaSemana = Model.Where(x => x.ETA != null && x.ETA <= hoy.AddDays(7) && x.ETA >= hoy).Count();
}

<style>

    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .card-indicador {
        background: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

        .card-indicador h2 {
            font-size: 32px;
            margin: 0;
        }

        .card-indicador span {
            color: #6c757d;
        }

    .indicador1 {
        border-left: 5px solid #f05a28;
    }

    .indicador2 {
        border-left: 5px solid #0d6efd;
    }

    .indicador3 {
        border-left: 5px solid #28a745;
    }

    .indicador4 {
        border-left: 5px solid #ffc107;
    }

    .table-container {
        background: white;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .table thead {
        background: #2c3e50;
        color: white;
    }

    .table tbody tr:hover {
        background: #f5f5f5;
    }

    .btn-nuevo {
        background: #f05a28;
        color: white;
        border: none;
    }

        .btn-nuevo:hover {
            background: #d84c1b;
            color: white;
        }

</style>

<div class="container-fluid mt-4">

    <h2 class="mb-4">🚢 Dashboard de Embarques</h2>

    <div class="dashboard-cards">

        <div class="card-indicador indicador1">
            <span>Embarques Abiertos</span>
            <h2>@abiertos</h2>
        </div>

        <div class="card-indicador indicador2">
            <span>En Tránsito</span>
            <h2>@enTransito</h2>
        </div>

        <div class="card-indicador indicador3">
            <span>Arribados</span>
            <h2>@arribados</h2>
        </div>

        <div class="card-indicador indicador4">
            <span>ETA esta semana</span>
            <h2>@etaSemana</h2>
        </div>

    </div>


    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4>Embarques Registrados</h4>

        <a asp-action="Create" class="btn btn-nuevo">
            + Nuevo Embarque
        </a>

    </div>

    <div class="table-container">

        <div class="table-responsive">

            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>Shipment</th>
                        <th>Marca</th>
                        <th>Puerto</th>
                        <th>Incoterm</th>
                        <th>Naviera</th>
                        <th>Qty</th>
                        <th>Departure</th>
                        <th>ETA</th>
                        <th>Días Tránsito</th>
                        <th>Estado</th>
                        <th></th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {

                        <tr>

                            <td>@item.Shipment</td>

                            <td>@item.Brand</td>

                            <td>@item.DestinationPort</td>

                            <td>@item.Incoterm</td>

                            <td>@item.ShippingCompany</td>

                            <td>@item.Qty</td>

                            <td>@item.DepartureDate?.ToShortDateString()</td>

                            <td>@item.ETA?.ToShortDateString()</td>

                            <td>

                                @if (item.DepartureDate != null && item.ETA != null)
                                {
                                    var dias = (item.ETA.Value - item.DepartureDate.Value).Days;
                                    @dias
                                }

                            </td>

                            <td>

                                @if (item.Estado == "OPEN")
                                {
                                    <span class="badge bg-secondary">OPEN</span>
                                }
                                else if (item.Estado == "IN TRANSIT")
                                {
                                    <span class="badge bg-primary">IN TRANSIT</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">ARRIVED</span>
                                }

                            </td>

                            <td>

                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                    Editar
                                </a>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
