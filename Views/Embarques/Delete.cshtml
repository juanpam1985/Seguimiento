@model Seguimiento.Models.Embarque

@{
    ViewData["Title"] = "Eliminar Embarque";
}

<div class="container mt-5">

    <div class="card p-4 shadow">

        <h3 class="text-danger">⚠️ Eliminar Embarque</h3>

        <p class="mt-3">
            ¿Estás seguro que deseas eliminar este embarque?
        </p>

        <div class="mb-3">
            <strong>Empresa:</strong> @Model.Empresa?.Nombre <br />
            @Model.FechaRegistro.ToString("dd/MM/yyyy")
                ? f.ToString("dd/MM/yyyy")
                : Model.FechaRegistro)
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Dashboard" class="btn btn-secondary">Cancelar</a>
        </form>

    </div>

</div>