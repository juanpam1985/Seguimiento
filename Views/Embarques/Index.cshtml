@model List<Seguimiento.Models.Embarque>

@{
    ViewData["Title"] = "Embarques";
}

<h3>📦 Lista de Embarques</h3>

<a asp-action="Create" class="btn btn-primary mb-3">Nuevo Embarque</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FechaRegistro.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                </td>
            </tr>
        }
    </tbody>
</table>