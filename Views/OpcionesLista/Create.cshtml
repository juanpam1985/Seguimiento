@model Seguimiento.Models.OpcionLista

@{
    ViewData["Title"] = "Crear Opción";
}

<div class="container mt-4">

    <h2 class="mb-3">➕ Crear Opción de Lista</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <!-- 🔽 PREGUNTA (ÚNICO CAMPO) -->
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Pregunta</label>

                    <select asp-for="PreguntaId"
                            asp-items="ViewBag.PreguntaId"
                            class="form-control">
                        <option value="">-- Seleccione una pregunta --</option>
                    </select>
                </div>

                <!-- ✏️ VALOR -->
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Valor</label>
                    <input asp-for="Valor" class="form-control" />
                </div>

                <!-- ☑️ ACTIVO -->
                <div class="form-check mb-3">
                    <input asp-for="Activo" class="form-check-input" />
                    <label class="form-check-label">Activo</label>
                </div>

                <button type="submit" class="btn btn-success">💾 Guardar</button>

            </form>

        </div>
    </div>

</div>