@model Seguimiento.Models.Pregunta

@{
    ViewData["Title"] = "Editar Pregunta";
}

<div class="container mt-4">

    <h2>✏️ Editar Pregunta</h2>

    <hr />

    <div class="row">
        <div class="col-md-6">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />

                <!-- NOMBRE -->
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

               

                <!-- ORDEN -->
                <div class="mb-3">
                    <label class="form-label">Orden</label>
                    <input asp-for="Orden" type="number" class="form-control" />
                    <span asp-validation-for="Orden" class="text-danger"></span>
                </div>

                <!-- ACTIVO -->
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Activo" />
                    <label class="form-check-label">Activo</label>
                </div>

                <!-- ES GENERAL -->
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="EsGeneral" id="chkGeneral" />
                    <label class="form-check-label">Pregunta General</label>
                </div>

                <!-- MODELO -->
                <div class="mb-3" id="divModelo">
                    <label class="form-label">Modelo</label>
                    <select asp-for="ModeloId" class="form-control" asp-items="ViewBag.Modelos">
                        <option value="">-- Seleccione Modelo --</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    💾 Guardar
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    ⬅ Cancelar
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function toggleModelo() {
            let esGeneral = document.getElementById("chkGeneral").checked;
            let divModelo = document.getElementById("divModelo");

            if (esGeneral) {
                divModelo.style.display = "none";
            } else {
                divModelo.style.display = "block";
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            toggleModelo();
            document.getElementById("chkGeneral").addEventListener("change", toggleModelo);
        });
    </script>
}