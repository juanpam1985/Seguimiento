@model Seguimiento.Models.Pregunta

@{
    ViewData["Title"] = "Crear Pregunta";
}

<style>

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .btn-lozano {
        background: #f05a28;
        border: none;
        color: white;
        font-weight: 500;
    }

        .btn-lozano:hover {
            background: #d84c1b;
            color: white;
        }

    .card-form {
        background: white;
        border-radius: 12px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        max-width: 700px;
        margin: auto;
    }

    .section-title {
        font-weight: 600;
        margin-bottom: 20px;
        color: #2c3e50;
        border-left: 4px solid #f05a28;
        padding-left: 10px;
    }

    .btn-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

</style>

<div class="container mt-4">

    <div class="page-header">

        <h3>❓ Crear Pregunta</h3>

        <a asp-action="Index" class="btn btn-secondary">
            ← Volver
        </a>

    </div>

    <div class="card-form">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="section-title">
                Configuración de la pregunta
            </div>

            <!-- NOMBRE -->
            <div class="mb-3">
                <label class="form-label">Texto de la Pregunta</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            

            <!-- ORDEN -->
            <div class="mb-3">
                <label class="form-label">Orden</label>
                <input asp-for="Orden" type="number" class="form-control" />
            </div>

            <!-- ACTIVO -->
            <div class="form-check mt-2">
                <input asp-for="Activo" class="form-check-input" />
                <label class="form-check-label">Activo</label>
            </div>

            <!-- ES GENERAL -->
            <div class="form-check mt-2">
                <input asp-for="EsGeneral" class="form-check-input" id="chkGeneral" />
                <label class="form-check-label">Pregunta General</label>
            </div>

            <!-- MODELO -->
            <div class="mb-3 mt-3" id="divModelo">
                <label class="form-label">Modelo</label>
                <select asp-for="ModeloId"
                        class="form-control"
                        asp-items="ViewBag.Modelos">
                    <option value="">Seleccione un modelo</option>
                </select>
            </div>

            <div class="btn-actions">

                <button type="submit" class="btn btn-lozano">
                    💾 Guardar Pregunta
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function toggleModelo() {
            let esGeneral = document.getElementById("chkGeneral").checked;
            let divModelo = document.getElementById("divModelo");

            if (esGeneral) {
                divModelo.style.display = "none";
            } else {
                divModelo.style.display = "block";
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            toggleModelo();
            document.getElementById("chkGeneral").addEventListener("change", toggleModelo);
        });
    </script>
}