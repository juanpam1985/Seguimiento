@model Seguimiento.Models.Pregunta

@{
    ViewData["Title"] = "Eliminar Pregunta";
}

<div class="container mt-4">

    <h2 class="text-danger">🗑️ Eliminar Pregunta</h2>

    <div class="alert alert-warning">
        ⚠️ ¿Estás seguro de eliminar esta pregunta? Esta acción no se puede deshacer.
    </div>

    <hr />

    <dl class="row">

        <dt class="col-sm-3 fw-bold">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

       

        <dt class="col-sm-3 fw-bold">Orden</dt>
        <dd class="col-sm-9">@Model.Orden</dd>

        <dt class="col-sm-3 fw-bold">Activo</dt>
        <dd class="col-sm-9">
            @if (Model.Activo)
            {
                <span class="badge bg-success">Sí</span>
            }
            else
            {
                <span class="badge bg-secondary">No</span>
            }
        </dd>

        <dt class="col-sm-3 fw-bold">Tipo</dt>
        <dd class="col-sm-9">
            @if (Model.EsGeneral)
            {
                <span class="badge bg-primary">General</span>
            }
            else
            {
                <span class="badge bg-info text-dark">Por Modelo</span>
            }
        </dd>

        <dt class="col-sm-3 fw-bold">Modelo</dt>
        <dd class="col-sm-9">
            @(Model.Modelo != null ? Model.Modelo.Nombre : "Todos")
        </dd>

    </dl>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            🗑️ Eliminar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            ⬅ Cancelar
        </a>
    </form>

</div>