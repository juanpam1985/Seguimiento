@model IEnumerable<Seguimiento.Models.Pregunta>

@{
    ViewData["Title"] = "Preguntas";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>❓ Preguntas del Sistema</h3>

        <div class="d-flex gap-2">
            <input id="buscarPregunta" type="text" class="form-control" placeholder="🔍 Buscar pregunta..." style="width:300px;" />

            <a asp-action="Create" class="btn btn-primary">
                ➕ Nueva Pregunta
            </a>
        </div>
    </div>

    <div class="mb-2">
        Total preguntas: <strong id="totalPreguntas">@Model.Count()</strong>
    </div>

    <div class="table-responsive">

        <table id="tablaPreguntas" class="table table-bordered table-hover align-middle">

            <thead class="table-dark text-center">
                <tr>
                    <th onclick="ordenarTabla(0)">Pregunta ▲▼</th>
                    <th onclick="ordenarTabla(1)">Modelo ▲▼</th>
                    <th onclick="ordenarTabla(2)">Orden ▲▼</th>
                    <th onclick="ordenarTabla(3)">General ▲▼</th>
                    <th onclick="ordenarTabla(4)">Estado ▲▼</th>
                    <th style="width:200px">Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <strong>@item.Nombre</strong>
                        </td>

                        <td class="text-center">
                            @(item.Modelo != null ? item.Modelo.Nombre : "General")
                        </td>

                        <td class="text-center">
                            @item.Orden
                        </td>

                        <td class="text-center">
                            @(item.EsGeneral ? "✔️" : "-")
                        </td>

                        <td class="text-center">
                            @if (item.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>

                        <td class="text-center">

                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                ✏️
                            </a>

                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">
                                🔍
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                🗑️
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script>

    // BUSCADOR
    document.getElementById("buscarPregunta").addEventListener("keyup", function () {

        let filtro = this.value.toLowerCase();
        let filas = document.querySelectorAll("#tablaPreguntas tbody tr");
        let total = 0;

        filas.forEach(fila => {

            let texto = fila.innerText.toLowerCase();

            if (texto.includes(filtro)) {
                fila.style.display = "";
                total++;
            } else {
                fila.style.display = "none";
            }

        });

        document.getElementById("totalPreguntas").innerText = total;

    });

    // ORDENAR
    function ordenarTabla(columna) {

        let tabla = document.getElementById("tablaPreguntas");
        let filas = Array.from(tabla.rows).slice(1);

        let asc = tabla.classList.toggle("asc");

        filas.sort((a, b) => {

            let A = a.cells[columna].innerText;
            let B = b.cells[columna].innerText;

            return asc ? A.localeCompare(B) : B.localeCompare(A);

        });

        filas.forEach(f => tabla.appendChild(f));
    }

</script>