@model Seguimiento.Models.Modelo

@{
    ViewData["Title"] = "Crear Modelo";
}

<style>

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .btn-lozano {
        background: #f05a28;
        border: none;
        color: white;
        font-weight: 500;
    }

        .btn-lozano:hover {
            background: #d84c1b;
            color: white;
        }

    .card-form {
        background: white;
        border-radius: 12px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        max-width: 600px;
        margin: auto;
    }

    .section-title {
        font-weight: 600;
        margin-bottom: 20px;
        color: #2c3e50;
        border-left: 4px solid #f05a28;
        padding-left: 10px;
    }

    .form-control {
        border-radius: 6px;
    }

    .btn-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

</style>

<div class="container mt-4">

    <div class="page-header">

        <h3>🚗 Crear Modelo</h3>

        <a href="/Modelos" class="btn btn-secondary">
            ← Volver
        </a>

    </div>

    <div class="card-form">

        <form asp-controller="Modelos" asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="section-title">
                Información del Modelo
            </div>

            <!-- MARCA -->
            <div class="mb-3">

                <label class="form-label">
                    Marca
                </label>

                <select asp-for="MarcaId"
                        class="form-control"
                        asp-items="ViewBag.MarcaId">

                    <option value="">Seleccione una marca</option>

                </select>

                <span asp-validation-for="MarcaId" class="text-danger"></span>

            </div>

            <!-- 🔥 TIPO MODELO -->
            <div class="mb-3">

                <!-- ✔ SOLO CAMBIÉ ESTA LÍNEA -->
                <label class="form-label">
                    Tipo de Modelo
                </label>

                <select asp-for="TipoModeloId"
                        class="form-control"
                        asp-items="ViewBag.TipoModeloId">

                    <option value="">-- Seleccione Tipo --</option>

                </select>

                <span asp-validation-for="TipoModeloId" class="text-danger"></span>

            </div>

            <!-- NOMBRE -->
            <div class="mb-3">

                <label class="form-label">
                    Nombre del Modelo
                </label>

                <input asp-for="Nombre" class="form-control" />

                <span asp-validation-for="Nombre" class="text-danger"></span>

            </div>

            <!-- ACTIVO -->
            <div class="form-check mt-3">

                <input asp-for="Activo" class="form-check-input" />

                <label class="form-check-label">Activo</label>

            </div>

            <!-- BOTONES -->
            <div class="btn-actions">

                <button type="submit" class="btn btn-lozano">
                    💾 Guardar Modelo
                </button>

                <a href="/Modelos" class="btn btn-outline-secondary">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}