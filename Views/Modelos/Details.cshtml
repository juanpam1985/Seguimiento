@model Seguimiento.Models.Modelo

@{
    ViewData["Title"] = "Detalle Modelo";
}

<style>
    .details-container {
        max-width: 800px;
        margin: auto;
    }

    .card-details {
        background: white;
        border-radius: 12px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .title-details {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 20px;
    }

    .info-label {
        font-weight: 600;
        color: #2c3e50;
    }

    .info-value {
        background: #f8f9fa;
        padding: 8px 12px;
        border-radius: 6px;
        display: inline-block;
        min-width: 220px;
    }

    .badge-activo {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 500;
    }

    .badge-inactivo {
        background: #ffebee;
        color: #c62828;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 500;
    }

    .btn-actions {
        margin-top: 25px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
</style>

<div class="container mt-4 details-container">

    <div class="card-details">
        <h3 class="title-details">📋 Detalle del Modelo</h3>

        <div class="mb-3">
            <span class="info-label">Marca:</span><br />
            <span class="info-value">
                @(Model.Marca != null ? Model.Marca.Nombre : "Sin marca")
            </span>
        </div>

        <div class="mb-3">
            <span class="info-label">Tipo de Modelo:</span><br />
            <span class="info-value">
                @(Model.TipoModelo != null ? Model.TipoModelo.Nombre : "Sin tipo")
            </span>
        </div>

        <div class="mb-3">
            <span class="info-label">Nombre del Modelo:</span><br />
            <span class="info-value">
                @Model.Nombre
            </span>
        </div>

        <div class="mb-3">
            <span class="info-label">Model:</span><br />
            <span class="info-value">
                @(string.IsNullOrWhiteSpace(Model.ModelPacking) ? "-" : Model.ModelPacking)
            </span>
        </div>

        <div class="mb-3">
            <span class="info-label">Model (SRI):</span><br />
            <span class="info-value">
                @(string.IsNullOrWhiteSpace(Model.ModelSRI) ? "-" : Model.ModelSRI)
            </span>
        </div>

        <div class="mb-3">
            <span class="info-label">Model (HOMOLOGACIÓN):</span><br />
            <span class="info-value">
                @(string.IsNullOrWhiteSpace(Model.ModelHomologacion) ? "-" : Model.ModelHomologacion)
            </span>
        </div>

        <div class="mb-3">
            <span class="info-label">Estado:</span><br />
            @if (Model.Activo)
            {
                <span class="badge-activo">Activo</span>
            }
            else
            {
                <span class="badge-inactivo">Inactivo</span>
            }
        </div>

        <div class="btn-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                ✏️ Editar
            </a>

            <a asp-action="Index" class="btn btn-outline-secondary">
                ← Volver
            </a>
        </div>
    </div>
</div>