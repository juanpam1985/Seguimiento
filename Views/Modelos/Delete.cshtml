@model Seguimiento.Models.Modelo

@{
    ViewData["Title"] = "Eliminar Modelo";
}

<style>

    .delete-container {
        max-width: 650px;
        margin: auto;
    }

    .card-delete {
        background: white;
        border-radius: 12px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .title-delete {
        color: #c62828;
        font-weight: 600;
    }

    .warning-box {
        background: #ffebee;
        color: #c62828;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-weight: 500;
    }

    .info-label {
        font-weight: 600;
        color: #2c3e50;
    }

    .info-value {
        background: #f8f9fa;
        padding: 8px 12px;
        border-radius: 6px;
        display: inline-block;
        min-width: 200px;
    }

    .badge-activo {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 500;
    }

    .badge-inactivo {
        background: #ffebee;
        color: #c62828;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 500;
    }

    .btn-actions {
        margin-top: 25px;
        display: flex;
        gap: 10px;
    }

</style>

<div class="container mt-4 delete-container">

    <div class="card-delete">

        <h3 class="title-delete">⚠️ Eliminar Modelo</h3>

        <div class="warning-box">
            ¿Estás seguro de que deseas eliminar este modelo? Esta acción no se puede deshacer.
        </div>

        <!-- MARCA -->
        <div class="mb-3">
            <span class="info-label">Marca:</span><br />
            <span class="info-value">
                @(Model.Marca != null ? Model.Marca.Nombre : "Sin marca")
            </span>
        </div>

        <!-- 🔥 TIPO MODELO (NUEVO) -->
        <div class="mb-3">
            <span class="info-label">Tipo de Modelo:</span><br />
            <span class="info-value">
                @(Model.TipoModelo != null ? Model.TipoModelo.Nombre : "Sin tipo")
            </span>
        </div>

        <!-- NOMBRE -->
        <div class="mb-3">
            <span class="info-label">Nombre del Modelo:</span><br />
            <span class="info-value">
                @Model.Nombre
            </span>
        </div>

        <!-- ESTADO -->
        <div class="mb-3">
            <span class="info-label">Estado:</span><br />
            @if (Model.Activo)
            {
                <span class="badge-activo">Activo</span>
            }
            else
            {
                <span class="badge-inactivo">Inactivo</span>
            }
        </div>

        <form asp-action="Delete" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="btn-actions">

                <button type="submit" class="btn btn-danger">
                    🗑 Eliminar
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>