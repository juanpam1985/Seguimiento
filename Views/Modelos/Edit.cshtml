@model Seguimiento.Models.Modelo

@{
    ViewData["Title"] = "Editar Modelo";
}

<style>
    .edit-container {
        max-width: 800px;
        margin: auto;
    }

    .card-edit {
        background: white;
        border-radius: 12px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .title-edit {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 6px;
    }

    .section-title {
        font-weight: 600;
        margin-bottom: 20px;
        color: #2c3e50;
        border-left: 4px solid #f05a28;
        padding-left: 10px;
    }

    .btn-actions {
        margin-top: 25px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-lozano {
        background: #f05a28;
        border: none;
        color: white;
        font-weight: 500;
    }

        .btn-lozano:hover {
            background: #d84c1b;
            color: white;
        }
</style>

<div class="container mt-4 edit-container">

    <div class="card-edit">
        <h3 class="title-edit">✏️ Editar Modelo</h3>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="section-title">
                Información del Modelo
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MarcaId" class="form-label">Marca</label>
                    <select asp-for="MarcaId" class="form-control" asp-items="ViewBag.MarcaId">
                        <option value="">Seleccione una marca</option>
                    </select>
                    <span asp-validation-for="MarcaId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Tipo de Modelo</label>
                    <select asp-for="TipoModeloId" class="form-control" asp-items="ViewBag.TipoModeloId">
                        <option value="">-- Seleccione Tipo --</option>
                    </select>
                    <span asp-validation-for="TipoModeloId" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre del Modelo</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <hr />

            <div class="section-title">
                Datos para Packing List
            </div>

            <div class="mb-3">
                <label asp-for="ModelPacking" class="form-label"></label>
                <input asp-for="ModelPacking" class="form-control" />
                <span asp-validation-for="ModelPacking" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ModelSRI" class="form-label"></label>
                <input asp-for="ModelSRI" class="form-control" />
                <span asp-validation-for="ModelSRI" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ModelHomologacion" class="form-label"></label>
                <input asp-for="ModelHomologacion" class="form-control" />
                <span asp-validation-for="ModelHomologacion" class="text-danger"></span>
            </div>

            <div class="form-check mt-3">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label">Activo</label>
            </div>

            <div class="btn-actions">
                <button type="submit" class="btn btn-lozano">
                    💾 Guardar Cambios
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}