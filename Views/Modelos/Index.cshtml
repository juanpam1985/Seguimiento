@model IEnumerable<Seguimiento.Models.Modelo>

@{
    ViewData["Title"] = "Modelos";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn-lozano {
        background: #f05a28;
        border: none;
        color: white;
        font-weight: 500;
    }

        .btn-lozano:hover {
            background: #d84c1b;
            color: white;
        }

    .card-table {
        background: white;
        border-radius: 10px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .table thead {
        background: #2c3e50;
        color: white;
    }

    .table tbody tr:hover {
        background: #f4f6f9;
    }

    .badge-activo {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 5px 12px;
        border-radius: 20px;
    }

    .badge-inactivo {
        background: #ffebee;
        color: #c62828;
        padding: 5px 12px;
        border-radius: 20px;
    }

    .search-box {
        width: 280px;
    }

    .counter {
        font-size: 14px;
        color: #6c757d;
        margin-bottom: 10px;
    }

    .acciones {
        white-space: nowrap;
    }
</style>

<div class="container-fluid mt-4">

    <div class="page-header">
        <h3>🚗 Modelos de Vehículos</h3>

        <div class="d-flex gap-3 flex-wrap">
            <input id="buscarModelo"
                   type="text"
                   class="form-control search-box"
                   placeholder="Buscar modelo..." />

            <a asp-action="Create" class="btn btn-lozano">
                ➕ Nuevo Modelo
            </a>
        </div>
    </div>

    <div class="counter">
        Total modelos: <strong id="totalModelos">@Model.Count()</strong>
    </div>

    <div class="card-table">
        <div class="table-responsive">
            <table id="tablaModelos" class="table table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Marca</th>
                        <th>Tipo</th>
                        <th>Model</th>
                        <th>Model (SRI)</th>
                        <th>Model (HOMOLOGACIÓN)</th>
                        <th>Estado</th>
                        <th style="width:180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Nombre</strong></td>
                            <td>@(item.Marca != null ? item.Marca.Nombre : "")</td>
                            <td>@(item.TipoModelo != null ? item.TipoModelo.Nombre : "")</td>
                            <td>@item.ModelPacking</td>
                            <td>@item.ModelSRI</td>
                            <td>@item.ModelHomologacion</td>
                            <td>
                                @if (item.Activo)
                                {
                                    <span class="badge-activo">Activo</span>
                                }
                                else
                                {
                                    <span class="badge-inactivo">Inactivo</span>
                                }
                            </td>
                            <td class="acciones">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info text-white">Ver</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    const input = document.getElementById("buscarModelo");
    const table = document.getElementById("tablaModelos");
    const rows = table.querySelectorAll("tbody tr");

    input.addEventListener("keyup", function () {
        let filtro = this.value.toLowerCase();
        let total = 0;

        rows.forEach(row => {
            let texto = row.innerText.toLowerCase();

            if (texto.includes(filtro)) {
                row.style.display = "";
                total++;
            } else {
                row.style.display = "none";
            }
        });

        document.getElementById("totalModelos").innerText = total;
    });
</script>