@model Seguimiento.Models.Respuesta

@{
    ViewData["Title"] = "Detalle Respuesta";
}

<h2>📄 Detalle de Respuesta</h2>

<hr />

<dl class="row">

    <dt class="col-sm-2">Embarque</dt>
    <dd class="col-sm-10">@Model.EmbarqueId</dd>

    <dt class="col-sm-2">Pregunta</dt>
    <dd class="col-sm-10">
        @(Model.Pregunta != null
            ? Model.Pregunta.Nombre
            : Model.PreguntaId.ToString())
    </dd>

    <dt class="col-sm-2">Valor</dt>
    <dd class="col-sm-10">
        @(string.IsNullOrEmpty(Model.Valor) ? "-" : Model.Valor)
    </dd>

    <dt class="col-sm-2">Fecha Registro</dt>
    <dd class="col-sm-10">
        @(Model.FechaRegistro.HasValue
            ? Model.FechaRegistro.Value.ToString("dd/MM/yyyy HH:mm")
            : "-")
    </dd>

</dl>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">⬅ Volver</a>
</div>