@model IEnumerable<Seguimiento.Models.Respuesta>

@{
    ViewData["Title"] = "Respuestas";
}

<h2>📋 Respuestas</h2>

<p>
    <a asp-action="Create" class="btn btn-success">➕ Nueva Respuesta</a>
</p>

<table class="table table-bordered table-striped table-hover">

    <thead class="table-dark">
        <tr>
            <th>Embarque</th>
            <th>Pregunta</th>
            <th>Valor</th>
            <th>Fecha Registro</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EmbarqueId</td>

                <td>
                    @(item.Pregunta != null
                        ? item.Pregunta.Nombre
                        : item.PreguntaId.ToString())
                </td>

                <td>@(item.Valor ?? "-")</td>

                <td>
                    @(item.FechaRegistro.HasValue
                        ? item.FechaRegistro.Value.ToString("dd/MM/yyyy")
                        : "-")
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">✏️</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">🔍</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">🗑️</a>
                </td>
            </tr>
        }

    </tbody>

</table>