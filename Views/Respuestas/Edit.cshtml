@model Seguimiento.Models.Respuesta

@{
    ViewData["Title"] = "Editar Respuesta";
}

<div class="container mt-4">

    <h2>✏️ Editar Respuesta</h2>

    <hr />

    <form asp-action="Edit">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="Id" />

        <!-- Embarque -->
        <div class="mb-3">
            <label class="form-label">Embarque</label>
            <input asp-for="EmbarqueId" class="form-control" readonly />
        </div>

        <!-- Pregunta -->
        <div class="mb-3">
            <label class="form-label">Pregunta</label>
            <input value="@(Model.Pregunta != null ? Model.Pregunta.Nombre : Model.PreguntaId.ToString())"
                   class="form-control" readonly />
        </div>

        <!-- Valor -->
        <div class="mb-3">
            <label class="form-label">Valor</label>
            <input asp-for="Valor" class="form-control" />
            <span asp-validation-for="Valor" class="text-danger"></span>
        </div>

        <!-- Fecha -->
        <div class="mb-3">
            <label class="form-label">Fecha Registro</label>
            <input asp-for="FechaRegistro" type="datetime-local" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            💾 Guardar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            ⬅ Volver
        </a>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}