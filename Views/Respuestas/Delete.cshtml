@model Seguimiento.Models.Respuesta

@{
    ViewData["Title"] = "Eliminar Respuesta";
}

<div class="container mt-4">

    <h2 class="text-danger">🗑️ Eliminar Respuesta</h2>

    <div class="alert alert-warning">
        ⚠️ ¿Seguro que deseas eliminar esta respuesta? Esta acción no se puede deshacer.
    </div>

    <hr />

    <dl class="row">

        <dt class="col-sm-3 fw-bold">Embarque</dt>
        <dd class="col-sm-9">@Model.EmbarqueId</dd>

        <dt class="col-sm-3 fw-bold">Pregunta</dt>
        <dd class="col-sm-9">
            @(Model.Pregunta != null
                ? Model.Pregunta.Nombre
                : Model.PreguntaId.ToString())
        </dd>

        <dt class="col-sm-3 fw-bold">Valor</dt>
        <dd class="col-sm-9">
            @(string.IsNullOrEmpty(Model.Valor) ? "-" : Model.Valor)
        </dd>

        <dt class="col-sm-3 fw-bold">Fecha Registro</dt>
        <dd class="col-sm-9">
            @(Model.FechaRegistro.HasValue
                ? Model.FechaRegistro.Value.ToString("dd/MM/yyyy HH:mm")
                : "-")
        </dd>

    </dl>

    <form asp-action="Delete" class="mt-3">

        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            🗑️ Eliminar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            ⬅ Cancelar
        </a>

    </form>

</div>