@model Seguimiento.Models.Respuesta

@{
    ViewData["Title"] = "Nueva Respuesta";
}

<h2>➕ Nueva Respuesta</h2>

<form asp-action="Create">

    <div class="form-group">
        <label>Embarque</label>
        <input asp-for="EmbarqueId" class="form-control" />
    </div>

    <div class="form-group">
        <label>Pregunta</label>
        <input asp-for="PreguntaId" class="form-control" />
    </div>

    <div class="form-group">
        <label>Valor</label>
        <input asp-for="Valor" class="form-control" />
    </div>

    <div class="form-group">
        <label>Fecha</label>
        <input asp-for="FechaRegistro" type="date" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-success">Guardar</button>

</form>