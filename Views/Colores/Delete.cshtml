@model Seguimiento.Models.Color

@{
    ViewData["Title"] = "Desactivar Color";
}

<div class="container mt-4">
    <div class="mb-3">
        <h2 class="fw-bold mb-1">Desactivar Color</h2>
        <p class="text-muted mb-0">Confirmación para desactivar el color del catálogo</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Atención:</strong> este registro no se eliminará físicamente, solo se marcará como inactivo.
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-3">Código</dt>
                <dd class="col-sm-9">@Model.Codigo</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3">Nombre Local</dt>
                <dd class="col-sm-9">@Model.NombreLocal</dd>

                <dt class="col-sm-3">Activo</dt>
                <dd class="col-sm-9">
                    @if (Model.Activo)
                    {
                        <span class="badge bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </dd>
            </dl>

            <hr class="my-4" />

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-ban me-1"></i> Desactivar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>